########################################
# Sol-Green 环境变量示例 / Example Env
# 复制为 .env 后再根据需要修改
# Copy to .env and adjust as needed
########################################

########################################
# 通用环境配置 / General Environment
########################################

# 运行环境：dev / test / mainnet
# Runtime environment: dev / test / mainnet
ENVIRONMENT=dev

# 默认链：solana / ethereum / polygon / bsc
# Default chain
DEFAULT_CHAIN=solana

########################################
# 后端服务基础配置 / Backend Basic Config
########################################

# 数据库类型：sqlite / postgres
# Database type
DB_TYPE=sqlite

# 使用 PostgreSQL 时的连接串（Docker 默认为下面这一条）
# PostgreSQL connection string (for docker-compose)
DATABASE_URL=postgres://solgreen:solgreen123@postgres:5432/solgreen?sslmode=disable

# 使用 SQLite 时可留空或自定义
# For SQLite you can leave this empty or set your own path
# DATABASE_URL=

########################################
# Redis 配置 / Redis Config
########################################

# Redis 地址
REDIS_URL=redis:6379

# Redis 密码（如无则留空）
REDIS_PASSWORD=

########################################
# 鉴权配置 / Auth & Security
########################################

# JWT 密钥（生产环境务必修改为足够复杂的随机字符串）
# JWT secret (CHANGE IN PRODUCTION)
JWT_SECRET=sol-green-secret-key

########################################
# Solana 配置 / Solana Config
########################################

# Solana RPC 节点地址
# Devnet (测试网)
SOLANA_RPC_URL=https://api.devnet.solana.com

# 管理员钱包私钥（Base58），用于合约交互、铸造等
# Admin wallet private key (Base58) – DO NOT COMMIT REAL KEYS
SOLANA_ADMIN_PRIVKEY=

########################################
# 多链支持（可选）/ Multichain Support (Optional)
########################################

# Ethereum
ETHEREUM_RPC_URL=
ETHEREUM_PRIVATE_KEY=
ETHEREUM_TOKEN_ADDRESS=

# Polygon
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
POLYGON_TOKEN_ADDRESS=

# BSC
BSC_RPC_URL=
BSC_PRIVATE_KEY=
BSC_TOKEN_ADDRESS=

########################################
# 第三方机构核查（可选）/ Third-Party Verification (Optional)
########################################

# 阿拉善 SEE
PARTNER_ALASHAN_ENABLED=false
PARTNER_ALASHAN_API=https://api.alashansee.org/v1/verify
PARTNER_ALASHAN_API_KEY=
PARTNER_ALASHAN_API_SECRET=

# 政府环保机构
PARTNER_GOV_ENABLED=false
PARTNER_GOV_API=https://api.gov-environment.gov.cn/v1/verify
PARTNER_GOV_API_KEY=
PARTNER_GOV_API_SECRET=

# UNEP
PARTNER_UNEP_ENABLED=false
PARTNER_UNEP_API=https://api.unep.org/v1/verify
PARTNER_UNEP_API_KEY=
PARTNER_UNEP_API_SECRET=

# WWF
PARTNER_WWF_ENABLED=false
PARTNER_WWF_API=https://api.wwf.org/v1/verify
PARTNER_WWF_API_KEY=
PARTNER_WWF_API_SECRET=

# Greenpeace
PARTNER_GREENPEACE_ENABLED=false
PARTNER_GREENPEACE_API=https://api.greenpeace.org/v1/verify
PARTNER_GREENPEACE_API_KEY=
PARTNER_GREENPEACE_API_SECRET=

########################################
# 其他预留配置 / Other Reserved Configs
########################################

# 如有新增环境变量，请同步更新此文件和文档
# Please keep this file in sync with docs when adding new vars

